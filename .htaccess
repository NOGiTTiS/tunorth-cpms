<IfModule mod_rewrite.c>
    Options -MultiViews
    RewriteEngine On
    RewriteBase /tunorth-cpms/

    # 1. Routing เข้า public/index.php โดยตรง
    RewriteRule ^$ public/index.php [L]

    # 2. ถ้าเข้าถึงไฟล์จริงๆ (เช่น images) ให้ข้ามไป
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. ส่ง Request อื่นๆ เข้าไปที่ public/index.php
    RewriteRule ^((?!public/).*)$ public/index.php?url=$1 [QSA,L]
</IfModule>